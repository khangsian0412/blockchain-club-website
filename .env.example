# Create an app at dashboard.privy.io and enable Email and Google login methods.
NEXT_PUBLIC_PRIVY_APP_ID=replace-with-your-privy-app-id

# Set after deploying ClubMembership. This frontend reads the contract directly.
NEXT_PUBLIC_MEMBERSHIP_CONTRACT=0x0000000000000000000000000000000000000000

# HTTPS JSON-RPC endpoint for the same chain used to deploy the contract.
# Example (Sepolia): https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_RPC_URL=https://your-rpc-endpoint.example

# Deployed Cloudflare Worker URL for the shared event board.
NEXT_PUBLIC_EVENTS_API_URL=https://nus-blockchain-club-events.blockchainclub.workers.dev
